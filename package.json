{
  "name": "muse-novel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun run db:migrate && next build",
    "depset": "bunx depset@latest @platejs --yes && bunx depset@latest platejs --yes",
    "dev": "next dev --hostname 127.0.0.1",
    "dev:web": "next dev --hostname 127.0.0.1",
    "lint": "biome lint . && eslint .",
    "lint:fix": "biome lint . --write && eslint . --fix",
    "preview": "bun run build && next start --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "start:web": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "knowledge:import": "node scripts/import-writing-reference.mjs",
    "knowledge:sync": "node scripts/sync-writing-sources.mjs",
    "knowledge:audit": "node scripts/audit-writing-knowledge.mjs"
