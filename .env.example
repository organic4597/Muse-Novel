# Database Provider (sqlite for local, turso for Vercel)
DATABASE_PROVIDER=sqlite

# Local SQLite (default)
# DATABASE_URL=sqlite.db

# Persistent uploads root. Docker defaults this to /app/data/uploads.
# UPLOADS_DIR=./data/uploads

# Single-user authentication. Set a long random setup token before first deployment,
# then remove it after the administrator account has been created.
# MUSE_AUTH_SETUP_TOKEN=
# MUSE_AUTH_DATA_DIR=./data/auth
# Trust X-Forwarded-* only behind a trusted proxy that overwrites those headers.
# AUTH_TRUST_PROXY=0

# Turso (Vercel deployment)
# TURSO_DATABASE_URL=libsql://your-db-turso.io
# TURSO_AUTH_TOKEN=your-token

# AI Provider API Keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=

# Ollama (local) — no API key needed, just set the base URL if non-default
# OLLAMA_BASE_URL=http://localhost:11434

# Encryption key for API keys stored in DB.
# Required for Turso/cloud. Local SQLite creates data/.encryption-key automatically.
# ENCRYPTION_KEY=

# External tag recommender API fallback (UI setting takes priority)
# TAG_RECOMMENDER_URL=http://127.0.0.1:9877

# SearXNG JSON search endpoint. UI settings take priority; no paid API key needed.
# WEB_SEARCH_URL=http://muse-search:8080
# Optional editable JSON catalog of preferred reference sites.
# WEB_RESEARCH_SOURCES_PATH=/app/data/web-research-sources.json

# Optional OpenAI-compatible embedding API for semantic story memory.
# When unavailable, Muse Novel automatically falls back to keyword retrieval.
# EMBEDDING_BASE_URL=http://127.0.0.1:8081
# EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# EMBEDDING_API_KEY=
# Change these when the server's pooling mode or model build changes to
# invalidate incompatible cached vectors.
# EMBEDDING_POOLING=server-default
# EMBEDDING_REVISION=
# Defaults next to DATABASE_URL (data/writing-knowledge-vectors.json).
# WRITING_KNOWLEDGE_VECTOR_CACHE_PATH=
# Change these when the embedding server's pooling or model weights change.
# EMBEDDING_POOLING=server-default
# EMBEDDING_REVISION=
# Defaults beside DATABASE_URL, for example data/writing-knowledge-vectors.json.
# WRITING_KNOWLEDGE_VECTOR_CACHE_PATH=

# External OpenAI-compatible Local LLM API fallback
# QWEN_LOCAL_URL=http://127.0.0.1:8321

# qwen-local requests share the model server's bounded single-slot scheduler.
# AI_LOCAL_CONCURRENCY=1
# AI_LOCAL_MAX_QUEUE_SIZE=24
# AI_LOCAL_RETRY_AFTER_SECONDS=15

# Optional external Markdown directory for the extensible writing wiki.
# WSL example: /mnt/d/WorkPlace/musenovel/knowledge/writing
# WRITING_KNOWLEDGE_DIR=

# Optional ChatGPT subscription connection (no API key).
# Docker installs Codex CLI 0.153.4. Native deployments need that executable.
# MUSE_CODEX_BIN=codex
